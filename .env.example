# ---------------------------------------------------------------------------
# Copy to .env and fill in. The server reads these at boot.
# ---------------------------------------------------------------------------

# Render injects PORT automatically (10000 by default). Do not set it locally.
# PORT=3000

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (data/caser.db).
# Point it at Turso to get a database that survives Render's ephemeral FS.
#
#   DATABASE_URL=libsql://<db-name>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
#
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Where the local SQLite file lives (only used when DATABASE_URL is empty).
DATA_DIR=./data

# --- House edge -------------------------------------------------------------
# RTP = share of wagered money returned to the player.
# 0.80 -> the house keeps 20%. Raise it to make the game friendlier.
# Clamped to 0.01..0.99. Verified by `node _test_rtp.js`.
RTP=0.80

# Multiplier in the upgrade-wheel formula chance% = stake/targetPrice * MULT,
# clamped to 1%..80% exactly like the original site.
#
# Defaults to RTP * 100 (so 0.80 -> 80), which keeps the house in profit.
# Set it to 103 for the real caser.one numbers - note 103 is a *player* edge
# (RTP 103%), which is what the live site runs to keep people gambling.
UPGRADE_MULTIPLIER=80

# --- Admin ------------------------------------------------------------------
# Token for the operator panel at /admin. REQUIRED - if it is missing the server
# generates a random one and prints it to the log on every boot, so it will
# change after each restart.
ADMIN_TOKEN=

# Accounts allowed to use the admin API from inside the site (comma separated).
# These sign in through the normal cookie flow, unlike the panel token.
ADMIN_IDS=player_10001

# Where the cached case payloads are read from / written to.
CASES_CACHE_DIR=./cases_cache

# Upstream CDN used by the fallback proxy for missing assets.
REMOTE_CDN=https://cdn.caser.day

# Node version for Render builds.
NODE_VERSION=22.11.0
