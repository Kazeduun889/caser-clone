# ---------------------------------------------------------------------------
# Copy to .env and fill in. The server reads these at boot.
# ---------------------------------------------------------------------------

# Render injects PORT automatically (10000 by default). Do not set it locally.
# PORT=3000

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (data/caser.db).
# Point it at Turso to get a database that survives Render's ephemeral FS.
#
#   DATABASE_URL=libsql://<db-name>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
#
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Where the local SQLite file lives (only used when DATABASE_URL is empty).
DATA_DIR=./data

# Where the cached case payloads are read from / written to.
CASES_CACHE_DIR=./cases_cache

# Upstream CDN used by the fallback proxy for missing assets.
REMOTE_CDN=https://cdn.caser.day

# Node version for Render builds.
NODE_VERSION=22.11.0
