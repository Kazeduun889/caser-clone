{
  "name": "caser-clone",
  "version": "1.0.0",
  "description": "1-in-1 clone of caser.one with cases, upgrade wheel, inventory and custom auth",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node _test_withdrawal.js && node _test_rtp.js && node _test_odds.js && node _test_mystery.js",
    "test:store": "node _test_withdrawal.js",
    "test:rtp": "node _test_rtp.js",
    "test:odds": "node _test_odds.js",
    "test:mystery": "node _test_mystery.js",
    "test:api": "node _test_api.js",
    "test:balance": "node _test_balance.js",
    "test:money": "node _test_money_format.js",
    "test:upgrade": "node _test_upgrade_live.js",
    "test:mystery:live": "node _test_mystery_live.js",
    "test:resilience": "node _test_resilience.js",
    "probe:render": "node _probe_render.js",
    "probe:assets": "node _probe_assets.js",
    "analyze:mystery": "node _analyze_mystery.js",
    "cleanup:test-users": "node _cleanup_test_users.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
