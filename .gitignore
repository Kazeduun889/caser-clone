# Dependencies
node_modules/

# Local SQLite database (state lives here - never commit it)
data/
*.db
*.db-wal
*.db-shm

# Local env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temp / local artifacts
_tmp*
*.out

